# Dockerized PostgreSQL
POSTGRES_DB=realtime_todo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Dockerized Redis
REDIS_PORT=6379

# App connection strings (inside host machine, not inside another container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realtime_todo
REDIS_URL=redis://localhost:6379
